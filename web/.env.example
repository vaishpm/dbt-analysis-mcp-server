# Cursor SDK — get your key at cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# dbt Cloud MCP
DBT_AUTH_HEADER=token <your-dbt-personal-access-token>
DBT_PROD_ENV_ID=<your-prod-environment-id>
DBT_MCP_URL=https://<your-subdomain>.eu1.dbt.com/api/ai/v1/mcp/

# Redash
REDASH_URL=https://redash.visable.com/
REDASH_API_KEY=<your-redash-api-key>

# Internal access token — shared with your team, protects the chat UI
INTERNAL_ACCESS_TOKEN=change-me-to-something-secret
